---
import Base from "../layouts/Base.astro";
import Rule from "../components/Rule.astro";

const plates = [
  {
    title: "The roadstead at Batavia",
    maker: "1705",
    source: "Rijksmuseum, RP-P-2018-3197",
    license: "CC0",
    href: "https://commons.wikimedia.org/wiki/File:Gezicht_op_Batavia,_RP-P-2018-3197.jpg",
  },
  {
    title: "The roadstead at Banda Neira",
    maker: "Rijksmuseum, 1843–45, series Gezigten uit Neêrlands Indië",
    source: "Rijksmuseum, RP-P-2016-2260-7-1",
    license: "CC0",
    href: "https://commons.wikimedia.org/wiki/File:Gezicht_vanaf_het_water_op_de_haven_van_Banda_Neira_De_reede_van_Banda._Banda_Neira_(titel_op_object)_Molukschen_Archipel_(serietitel_op_object)_Gezigten_uit_Ne%C3%AArlands_Indi%C3%AB_(serietitel_op_object),_RP-P-2016-2260-7-1.jpg",
  },
  {
    title: "Gunung Sumbing",
    maker: "Carl Wilhelm Mieling, after Frans Wilhelm Junghuhn, 1853–54",
    source: "Rijksmuseum",
    license: "CC0",
    href: "https://commons.wikimedia.org/wiki/File:Gezicht_op_de_berg_Sumbing_op_Java,_Carl_Wilhelm_Mieling_(mogelijk),_naar_Frans_Wilhelm_Junghuhn,_1853_-_1854.jpg",
  },
  {
    title: "Plan of Batavia (and its title cartouche)",
    maker: "Claudius Anthony van Luepken / Johannes Rach, 1761",
    source: "Nationaal Archief, AMH-5579-NA",
    license: "public domain",
    href: "https://commons.wikimedia.org/wiki/File:AMH-5579-NA_Map_of_Batavia.jpg",
  },
  {
    title: "The castle of Batavia",
    maker: "Johannes Rach, 1767",
    source: "via Wikimedia Commons",
    license: "public domain",
    href: "https://commons.wikimedia.org/wiki/File:Casteel_te_Batavia_1767.jpg",
  },
];

const elsewhere = [
  { href: "https://github.com/sawungrana", label: "github.com/sawungrana" },
  { href: "https://huggingface.co/sawungrana", label: "huggingface.co/sawungrana" },
];
---
<Base
  title="colophon — lantip.space"
  description="Plate sources and licenses, why the site is called lantip, and where to find these projects elsewhere."
>
  <div class="mx-auto max-w-4xl px-6 pt-12">
    <p class="stamp-text text-ink-soft">house rules</p>
    <h1 class="mt-3 text-[2.2rem] leading-none text-ink-deep">Colophon</h1>
    <p class="mt-5 max-w-2xl text-[1.15rem]">
      Sources and licenses, and where to find these projects elsewhere.
    </p>

    <section class="mt-12">
      <h2 class="text-[1.5rem] text-ink-deep">Plates</h2>
      <p class="mt-4 max-w-2xl">
        Every engraving on this site is public domain or CC0, from the Rijksmuseum and the
        Nationaal Archief, via Wikimedia Commons.
      </p>
      <ul class="mt-6 max-w-2xl space-y-4">
        {
          plates.map((p) => (
            <li>
              <a href={p.href} class="font-semibold text-ink-deep no-underline hover:text-accent">
                {p.title}
              </a>
              <p class="text-[0.95rem] text-ink-soft">
                {p.maker} · {p.source} · {p.license}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12 max-w-2xl">
      <h2 class="text-[1.5rem] text-ink-deep">Why lantip</h2>
      <p class="mt-4">
        Lantip is Javanese for sharp. The site is named after my son.
      </p>
    </section>

    <Rule />

    <section class="max-w-2xl pb-4">
      <h2 class="text-[1.5rem] text-ink-deep">Elsewhere</h2>
      <ul class="mt-4 space-y-2">
        {
          elsewhere.map((e) => (
            <li>
              <a href={e.href} class="font-mono text-[0.9rem] text-ink no-underline hover:text-accent">
                {e.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-4">
        Corrections and questions: open an issue on the
        <a href="https://github.com/sawungrana/lantipspace-site/issues"> site repository</a>.
      </p>
    </section>
  </div>
</Base>
