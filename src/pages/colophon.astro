---
import Base from "../layouts/Base.astro";
import Rule from "../components/Rule.astro";

const plates = [
  {
    title: "The roadstead at Batavia",
    maker: "1705",
    source: "Rijksmuseum, RP-P-2018-3197",
    license: "CC0",
    href: "https://commons.wikimedia.org/wiki/File:Gezicht_op_Batavia,_RP-P-2018-3197.jpg",
  },
  {
    title: "The roadstead at Banda Neira",
    maker: "Rijksmuseum, 1843–45, series Gezigten uit Neêrlands Indië",
    source: "Rijksmuseum, RP-P-2016-2260-7-1",
    license: "CC0",
    href: "https://commons.wikimedia.org/wiki/File:Gezicht_vanaf_het_water_op_de_haven_van_Banda_Neira_De_reede_van_Banda._Banda_Neira_(titel_op_object)_Molukschen_Archipel_(serietitel_op_object)_Gezigten_uit_Ne%C3%AArlands_Indi%C3%AB_(serietitel_op_object),_RP-P-2016-2260-7-1.jpg",
  },
  {
    title: "Gunung Sumbing",
    maker: "Carl Wilhelm Mieling, after Frans Wilhelm Junghuhn, 1853–54",
    source: "Rijksmuseum",
    license: "CC0",
    href: "https://commons.wikimedia.org/wiki/File:Gezicht_op_de_berg_Sumbing_op_Java,_Carl_Wilhelm_Mieling_(mogelijk),_naar_Frans_Wilhelm_Junghuhn,_1853_-_1854.jpg",
  },
  {
    title: "Plan of Batavia (and its title cartouche)",
    maker: "Claudius Anthony van Luepken / Johannes Rach, 1761",
    source: "Nationaal Archief, AMH-5579-NA",
    license: "public domain",
    href: "https://commons.wikimedia.org/wiki/File:AMH-5579-NA_Map_of_Batavia.jpg",
  },
  {
    title: "The castle of Batavia",
    maker: "Johannes Rach, 1767",
    source: "via Wikimedia Commons",
    license: "public domain",
    href: "https://commons.wikimedia.org/wiki/File:Casteel_te_Batavia_1767.jpg",
  },
];
---
<Base
  title="colophon — lantip.space"
  description="How this site is made: type, ornaments, plates, and sources — and why it's called lantip."
>
  <div class="mx-auto max-w-4xl px-6 pt-12">
    <p class="stamp-text text-ink-soft">house rules</p>
    <h1 class="mt-3 text-[2.2rem] leading-none text-ink-deep">Colophon</h1>

    <section class="mt-12 max-w-2xl">
      <h2 class="text-[1.5rem] text-ink-deep">The site</h2>
      <p class="mt-4">
        Static HTML built with Astro. No database, no server, no analytics, no cookies.
        Fonts are self-hosted, so reading this page doesn't phone anyone. There's no
        JavaScript on the site at all — if one ever becomes unavoidable, it will be one
        small file and nothing else.
      </p>
    </section>

    <section class="mt-12 max-w-2xl">
      <h2 class="text-[1.5rem] text-ink-deep">Type</h2>
      <p class="mt-4">
        EB Garamond for prose, Fragment Mono for files, endpoints, and version numbers.
        Both are open source.
      </p>
    </section>

    <section class="mt-12 max-w-2xl">
      <h2 class="text-[1.5rem] text-ink-deep">Ornaments</h2>
      <p class="mt-4">
        The guilloche patterns on this site are generated by a small script in the
        repository — spirograph mathematics, written from scratch. The rosette isn't a scan;
        it's about two thousand points of arithmetic.
      </p>
    </section>

    <section class="mt-12">
      <h2 class="text-[1.5rem] text-ink-deep">Plates</h2>
      <p class="mt-4 max-w-2xl">
        Every engraving here is public domain or CC0, and comes from the Rijksmuseum or the
        Nationaal Archief via Wikimedia Commons. They are re-toned, never redrawn. This is
        not a decoration choice so much as a rule: the only images on this site are ones
        that belong to everybody.
      </p>
      <ul class="mt-6 max-w-2xl space-y-4">
        {
          plates.map((p) => (
            <li>
              <a href={p.href} class="font-semibold text-ink-deep no-underline hover:text-accent">
                {p.title}
              </a>
              <p class="text-[0.95rem] text-ink-soft">
                {p.maker} · {p.source} · {p.license}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12 max-w-2xl">
      <h2 class="text-[1.5rem] text-ink-deep">Why lantip</h2>
      <p class="mt-4">
        <em>Lantip</em> is Javanese for sharp. It's also my son's name. The site is named
        after him, and the nerdier it gets, the more it's for him anyway.
      </p>
    </section>

    <Rule />

    <section class="max-w-2xl pb-4">
      <p>
        Questions, corrections, and bug reports go to
        <a href="https://github.com/sawungrana">github.com/sawungrana</a>. There's no
        newsletter, nothing to subscribe to, and no way to sign up for anything.
      </p>
    </section>
  </div>
</Base>
